#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
EXTRA_COMMANDS="check"
EXTRA_HELP="        check   Validate the local configuration without starting"

. "${IPKG_INSTROOT:-}/usr/lib/singbox/common.sh"

check() {
    sbox_load && sbox_validate && sbox_check
}

start_service() {
    sbox_load
    [ "$ENABLED" = 1 ] || return 0
    sbox_validate || return 1
    procd_open_instance main
    procd_set_param command /usr/libexec/singbox-run
    procd_set_param user root
    procd_set_param file "$CONF" /etc/config/singbox
    procd_set_param limits core="0" nofile="65535 65535"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 20
    # Missing storage or a crashed core can recover; wait between retries.
    procd_set_param respawn 3600 "$RESPAWN_TIMEOUT" 0
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger singbox
}

# rc.common's procd reload handling restarts an instance when files change.
