config global
	option anon_swap '0'
	option anon_mount '0'
	option auto_swap '0'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '1'

config mount 'arthur_data'
	option target '/mnt/mmcblk0p27'
	option device '/dev/mmcblk0p27'
	option fstype 'ext4'
	option options 'rw,noatime'
	option enabled '1'
	option check_fs '1'
