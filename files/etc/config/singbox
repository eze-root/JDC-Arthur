config singbox 'main'
	option enabled '1'
	option mode 'tproxy'
	option client_ipv6 '0'
	option data_mount '/mnt/mmcblk0p27'
	option data_root '/mnt/mmcblk0p27/sing-box'
	option data_device '/dev/mmcblk0p27'
	option bin_path '/mnt/mmcblk0p27/sing-box/bin/sing-box'
	option packaged_bin '/usr/bin/sing-box'
	option config_path '/mnt/mmcblk0p27/sing-box/config/config.json'
	option direct_config '/usr/share/singbox/direct-ipv4.json'
	option sbox_dir '/mnt/mmcblk0p27/sing-box/state'
	option tproxy_port '9898'
	option tproxy_port6 '9899'
	option fwmark '100'
	option route_table '100'
	option rule_priority '10000'
	option lan_ifnames 'br-lan'
	option respawn_timeout '30'
	option config_url ''
	option update_on_boot '1'
	option update_retries '6'
	option update_retry_delay '30'
	option download_timeout '30'
	option max_config_bytes '4194304'
